{
	"name": "vite-react-template",
	"description": "Plexigent — Connecting Dots. A static brand experience.",
	"dependencies": {
		"react": "19.2.1",
		"react-dom": "19.2.1"
	},
	"devDependencies": {
		"@eslint/js": "9.39.1",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "7.3.6",
		"wrangler": "4.88.0"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"check": "npm run test && npm run build && npm run test:build",
		"deploy": "npm run check && wrangler deploy --config wrangler.json",
		"dev": "vite --host 0.0.0.0",
		"lint": "eslint .",
		"preview": "vite preview --host 0.0.0.0",
		"test": "node --test scripts/experience.test.mjs scripts/controller.test.mjs",
		"test:build": "CHECK_BUILD=1 node --test scripts/experience.test.mjs",
		"deploy:check": "wrangler deploy --config wrangler.json --dry-run"
	},
	"type": "module",
	"engines": {
		"node": ">=24.0.0"
	}
}
